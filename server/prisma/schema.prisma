generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  avatarUrl String?
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Document {
  id               String     @id @default(cuid())
  title            String
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  isArchived       Boolean    @default(false)
  parentDocumentId String?
  parentDocument   Document?  @relation("DocumentToChildren", fields: [parentDocumentId], references: [id])
  children         Document[] @relation("DocumentToChildren")
  content          String?    @db.LongText
  coverImage       String?
  coverPosition    Float?
  icon             String?
  isPublished      Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId])
  @@index([userId, parentDocumentId])
  @@index([userId, isArchived])
}
